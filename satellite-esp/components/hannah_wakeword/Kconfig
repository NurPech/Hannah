menu "Hannah Wake Word"

    config HANNAH_WAKEWORD_ENABLED
        bool "Wake-Word-Erkennung aktivieren"
        default y
        help
            Aktiviert die lokale Wake-Word-Erkennung (microWakeWord, TFLite Micro).
            Wenn deaktiviert: PTT-Modus (Taster halten zum Sprechen).

    config HANNAH_WAKEWORD_THRESHOLD
        int "Erkennungsschwelle (0–100)"
        default 75
        range 0 100
        depends on HANNAH_WAKEWORD_ENABLED
        help
            Confidence-Schwelle für die Wake-Word-Erkennung (Prozent).
            75 (~0.75) ist ein guter Startwert.

    config HANNAH_VAD_SILENCE_MS
        int "Stille-Timeout nach Erkennung (ms)"
        default 1500
        range 500 5000
        help
            Wie lange Stille anhält bis audio_end gesendet wird.

    config HANNAH_VAD_WEBRTC_AGGRESSIVENESS
        int "WebRTC VAD Aggressivität (0–3)"
        default 2
        range 0 3
        help
            Aggressivität der WebRTC-VAD-Stille-Erkennung.
            0 = sensitiv (weniger Nicht-Sprache herausgefiltert),
            3 = aggressiv (Musik und Hintergrundgeräusche zuverlässig als Stille erkannt).

    config HANNAH_TFLITE_ARENA_KB
        int "TFLite-Micro Arena-Größe (KB)"
        default 128
        range 64 4096
        help
            Arbeitsspeicher für den TFLite-Micro-Interpreter.
            Bei AllocateTensors-Fehler erhöhen — arena_used_bytes() im Log
            (Erfolgs- oder Fehlerfall) zeigt den tatsächlichen Bedarf.
            Modellabhängig, nicht nur von der reinen Dateigröße: ein
            hey_hannah-Retrain (90 Ops, CNN-Streaming) brauchte real nur
            29332 B; ein anderer Retrain mit anderer Architektur (LayerNorm-
            artig statt CNN) scheiterte dagegen komplett am Kernel, nicht an
            der Arena-Größe (#171/#172).

endmenu
