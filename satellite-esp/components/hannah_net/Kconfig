menu "Hannah Network"

    config HANNAH_WIFI_SSID
        string "WiFi SSID"
        default "smarthome"
        help
            SSID des WLAN-Netzwerks.

    config HANNAH_WIFI_PASS
        string "WiFi Passwort"
        default ""
        help
            WPA2-Passwort. Leer lassen für offene Netzwerke.

    config HANNAH_MQTT_BROKER
        string "MQTT Broker Adresse"
        default "192.168.8.1"
        help
            IP-Adresse oder Hostname des MQTT-Brokers.

    config HANNAH_MQTT_PORT
        int "MQTT Broker Port"
        default 1883
        range 1 65535

    config HANNAH_MQTT_USER
        string "MQTT Benutzername"
        default "mqtt"

    config HANNAH_MQTT_PASS
        string "MQTT Passwort"
        default ""

    config HANNAH_UDP_LISTEN_PORT
        int "UDP Empfangsport (TTS)"
        default 7776
        range 1024 65535
        help
            Lokaler UDP-Port auf dem TTS-Audio und Status-Meldungen
            vom Go-Proxy empfangen werden.

    config HANNAH_UDP_TIMEOUT_MS
        int "UDP Send Timeout (ms)"
        default 100
        help
            Timeout für UDP-Audio-Pakete. Bei Überschreitung wird das
            Paket verworfen (kein Blocking).

    config HANNAH_HEARTBEAT_INTERVAL_S
        int "Heartbeat-Intervall (s)"
        default 10
        range 5 300
        help
            Intervall in Sekunden zwischen Heartbeat-Paketen an den Proxy.

    config HANNAH_WIFI_MAX_RETRY
        int "WiFi Reconnect-Versuche"
        default 10
        range 1 50
        help
            Maximale Anzahl WiFi-Reconnects bevor esp_restart() aufgerufen wird.

    config HANNAH_NET_WATCHDOG_TIMEOUT_S
        int "Netzwerk-Watchdog Timeout (s)"
        default 240
        range 30 600
        help
            Vergeht seit dem letzten bestätigten Netzwerk-Lebenszeichen
            (IP-Bezug, MQTT-Connect/-Datenempfang oder heartbeat_ack vom
            Proxy/Core) mehr Zeit als hier eingestellt, löst der
            Heartbeat-Task aktiv esp_restart() aus. Fängt einen
            "Zombie"-WLAN-Zustand ab, bei dem WIFI_EVENT_STA_DISCONNECTED
            nicht mehr feuert und daher weder die reaktive Reconnect-Logik
            noch der AP-Mode-Fallback (beide an dieses Event gekoppelt)
            greifen. Muss deutlich über der Zeit liegen, die ein normaler
            STA→AP-Mode-Übergang (HANNAH_WIFI_MAX_RETRY Reconnect-Versuche)
            braucht, sonst überholt der Watchdog einen legitimen Reconnect.

endmenu
