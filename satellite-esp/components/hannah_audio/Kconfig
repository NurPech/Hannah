menu "Hannah Audio"

    config HANNAH_AUDIO_SAMPLE_RATE
        int "Sample Rate (Hz)"
        default 16000
        help
            Muss mit Hannah Core übereinstimmen (config.yaml: audio.sample_rate).

    config HANNAH_AUDIO_FRAME_MS
        int "Audio Frame Größe (ms)"
        default 30
        help
            Länge eines UDP-Pakets in Millisekunden.
            30 ms @ 16 kHz = 480 Samples = 960 Bytes (16-bit mono).

    choice HANNAH_MIC_TYPE
        prompt "Mikrofon Typ"
        default HANNAH_MIC_TYPE_I2S
        help
            I2S Standard für Breadboard (INMP441).
            PDM für PCB-Bestückung (zwei Mics teilen CLK+DATA, SEL bestimmt L/R).
            TDM für PCB Rev.5+ (vier PDM-Mics via ADAU7118 PDM→TDM-Wandler,
            ein gemeinsamer I2S-TDM-Stream).
            None für reine Announcement-Empfänger oder Sensor-Nodes.

        config HANNAH_MIC_TYPE_I2S
            bool "I2S Standard (INMP441, Breadboard)"

        config HANNAH_MIC_TYPE_PDM
            bool "PDM (PCB)"

        config HANNAH_MIC_TYPE_TDM
            bool "TDM (PDM→TDM-Wandler ADAU7118, PCB Rev.5+)"

        config HANNAH_MIC_TYPE_NONE
            bool "Kein Mikrofon"
    endchoice

    config HANNAH_TDM_DOWNMIX_GAIN
        int "TDM-Downmix-Verstärkung (Faktor)"
        default 128
        range 1 200
        depends on HANNAH_MIC_TYPE_TDM
        help
            Digitale Verstärkung des ADAU7118-TDM-Rohsignals (kein eigenes
            Gain-Register auf dem Chip, s. Issue #222). Gegen reale
            Nutzungsentfernung abgestimmt (128, sauberes Signal ohne Clipping).
            Runtime-Override per NVS/WebUI möglich, ohne Reflash.

    config HANNAH_SPK_OUTPUT_GAIN_PERCENT
        int "Speaker-Output-Gain (%)"
        default 100
        range 1 100
        depends on HANNAH_MIC_TYPE_TDM
        help
            Kopfraum-Reduktion für sämtliches von Hannah Core gestreamtes
            Audio (TTS/Announcement/Asset), vor der User-Lautstärke
            angewendet. Auf Rev.5 sind die Lautsprecher subjektiv zu laut
            (Refs #232) — 70% Original-Pegel = 100% für den Satelliten.
            100 = keine Reduktion (Rev.4-Verhalten). Schätzwert, ggf.
            nachzujustieren. Runtime-Override per NVS/WebUI möglich, ohne
            Reflash.

    config HANNAH_TDM_BEAM_DIRECTION_DEG
        int "TDM-Beamforming-Vorzugsrichtung (Grad)"
        default 180
        range 0 315
        depends on HANNAH_MIC_TYPE_TDM
        help
            Hörrichtung des Delay-and-Sum-Beamformings, im Uhrzeigersinn ab
            Norden (Kreuz-Array-Achse Richtung Stromversorgung), in 45°-
            Schritten (0/45/.../315 — feinere Werte bringen physikalisch
            keine zusätzliche Auflösung, s. Issue #222). Default 180° =
            Süden, der Stromversorgung gegenüber, konzeptionell die Front.
            Runtime-Override per NVS/WebUI möglich, ohne Reflash.

    config HANNAH_SPEAKER_ENABLED
        bool "Speaker aktivieren (MAX98357A / I2S-Verstärker)"
        default y
        help
            Deaktivieren für reine Sensor-Nodes ohne Lautsprecher.
            TTS-Announcements werden dann nicht abgespielt.

    config HANNAH_MIC_I2S_PORT
        int "Mikrofon I2S Port"
        default 0
        range 0 1

    config HANNAH_MIC_BCK_GPIO
        int "Mikrofon BCK GPIO"
        default 4
        depends on HANNAH_MIC_TYPE_I2S || HANNAH_MIC_TYPE_TDM
        help
            Bei TDM: BCLK-Ausgang des ADAU7118.

    config HANNAH_MIC_WS_GPIO
        int "Mikrofon WS GPIO"
        default 5
        depends on HANNAH_MIC_TYPE_I2S || HANNAH_MIC_TYPE_TDM
        help
            Bei TDM: FSYNC-Ausgang des ADAU7118.

    config HANNAH_MIC_CLK_GPIO
        int "Mikrofon CLK GPIO"
        default 39
        depends on HANNAH_MIC_TYPE_PDM

    config HANNAH_MIC_DATA_GPIO
        int "Mikrofon DATA GPIO"
        default 40

    config HANNAH_SPK_I2S_PORT
        int "Speaker I2S Port"
        default 1
        range 0 1

    config HANNAH_SPK_BCK_GPIO
        int "Speaker BCK GPIO"
        default 47

    config HANNAH_SPK_WS_GPIO
        int "Speaker WS GPIO"
        default 38

    config HANNAH_SPK_DATA_GPIO
        int "Speaker DATA GPIO"
        default 21

    config HANNAH_MUTE_GPIO
        int "Mute-Taster GPIO"
        default 11
        help
            GPIO des Hardware-Mute-Tasters. Gegen GND geschaltet,
            interner Pull-up wird aktiviert.

    config HANNAH_MUTE_HW_GPIO
        int "Hardware-Mute Ausgang GPIO"
        default 10
        help
            GPIO der den NPN-Transistor der Mic-Mute-Schaltung steuert.
            HIGH = Mics aktiv, LOW = Mics hardware-stumm.

    config HANNAH_PTT_GPIO
        int "PTT-Taster GPIO"
        default 12
        help
            GPIO des Push-to-Talk-Tasters. Gedrückt halten → Aufnahme starten,
            Loslassen → audio_end. Funktioniert in beiden Modi (PTT und Wakeword).

    config HANNAH_VOL_UP_GPIO
        int "Lauter-Taster GPIO"
        default 13
        help
            GPIO des Lauter-Tasters. Jeder Druck erhöht die Lautstärke um HANNAH_VOLUME_STEP.

    config HANNAH_VOL_DOWN_GPIO
        int "Leiser-Taster GPIO"
        default 14
        help
            GPIO des Leiser-Tasters. Jeder Druck senkt die Lautstärke um HANNAH_VOLUME_STEP.

    config HANNAH_VOLUME_DEFAULT
        int "Standard-Lautstärke (%)"
        default 80
        range 1 100

    config HANNAH_VOLUME_STEP
        int "Lautstärke-Schritt (%)"
        default 10
        range 1 50
        help
            Schrittweite pro Tastendruck für Vol+/Vol-.

    config HANNAH_WAKEWORD_DEBUG
        bool "Wakeword-Debug-Infrastruktur aktivieren"
        default n
        help
            Periodische "Wakeword-Debug"-Log-Zeile (rms/peak/confidence/mel-
            /input-preview, alle ~500ms) plus der 4s-Roh-PCM-Ringpuffer samt
            Vol+/Vol--Tastenkombi- und Remote-Snapshot (GET /debug/wav(/capture)),
            inkl. frame_no-Zähler (#197). Aus #173/#180/#194/#197, entscheidend
            beim Finden von #198. Auf "n" umgestellt (#199), nachdem sich #198
            über einen längeren Zeitraum bewährt hat. Bei "n": kein Log-Spam,
            kein RAM-Verbrauch für den Ringpuffer (~125 KB PSRAM),
            /debug/wav(/capture) bleiben erreichbar, melden aber nur
            "keine Aufnahme verfügbar".

endmenu
